      "@type": "FAQPage",
      "@id": "${PUBLIC_SITE_URL}/encar-na-russkom-kak-chitat/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли официальный Encar на русском?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Полноценной русской версии encar.com нет. Делайте так: откройте оригинал и включите перевод браузера; global.encar.com – экспортный контур для партнёров, не розничный RU-магазин. Сайты из поиска \"encar на русском\" чаще всего посредники."
          }
        },
        {
          "@type": "Question",
          "name": "Как правильно перевести цену в 만원?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Умножьте число манвонов на 10 000 – получите воны. Например, 1 850 → 18 500 000 KRW. В эту сумму не входят доставка, пошлина и утильсбор: их считают отдельно под ваш сценарий."
          }
        },
        {
          "@type": "Question",
          "name": "Что значит \"без аварий\" / 무사고 на Encar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обычно это отсутствие ремонта силового каркаса, а не идеальный кузов. Двери, капот и крылья могли менять как простой ремонт. Смотрите схему X/W, а не только ярлык в шапке."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли верить пробегу в карточке Encar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Как ориентир – да, как финальному вердикту – нет. Сверьте хронологию и при осмотре блоки ЭБУ. Расхождение больше 5 000 км – стоп до депозита."
          }
        },
        {
          "@type": "Question",
          "name": "Чем Trust Encar отличается от диагностики Encar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Trust Encar в русской выдаче часто про коммерческий канал. Диагностика Encar (엔카진단) – бейдж/проверка площадки по рамке. Ни то, ни другое не заменяет ваш выездной осмотр и полный VIN-пакет."
          }
        },
        {
          "@type": "Question",
          "name": "Когда остановиться и звать подборщика?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если нет VIN, есть X/W на силовых, скачет пробег или продавец не даёт историю – остановитесь. Передайте лот подборщику до любой предоплаты и не торгуйтесь \"на вере\"."
          }
        }
      ]
