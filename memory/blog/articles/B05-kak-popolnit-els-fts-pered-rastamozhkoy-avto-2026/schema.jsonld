      "step": [
        {"@type": "HowToStep", "position": 1, "name": "Запросите сумму платежей у менеджера", "text": "За 2–3 рабочих дня до подачи документов запросите у менеджера актуальную сумму платежей и не ждите пятницы вечером: обычные поступления казначейство проводит в рабочие дни.", "url": "https://avtosales125.ru/kak-popolnit-els-fts-pered-rastamozhkoy-avto-2026/#поймите-зачем-елс-до-прихода-авто-на-свх", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 2, "name": "Откройте ЛК ФТС через Госуслуги", "text": "Войдите в личный кабинет участника ВЭД через Госуслуги как физическое лицо, найдите сервис «Лицевой счёт. Информация об остатках для физических лиц» и посмотрите текущий остаток.", "url": "https://avtosales125.ru/kak-popolnit-els-fts-pered-rastamozhkoy-avto-2026/#откройте-личный-кабинет-фтс-и-найдите-остаток", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 3, "name": "Пополните ЕЛС через СБП своей картой", "text": "В окне пополнения выберите СБП, укажите сумму с небольшим запасом под курс и оплатите только своей картой или счётом. Ориентир обновления остатков — около 15 минут в рабочий день.", "url": "https://avtosales125.ru/kak-popolnit-els-fts-pered-rastamozhkoy-avto-2026/#пополните-елс-через-сбп-пошагово", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 4, "name": "Сверьте реквизиты при оплате через банк", "text": "Если платите без ЛК, сверьте КБК аванса 15301061301010000510 и код органа в поле 107 (чаще 10000010). Не копируйте чужой код 10702000 без письменной сверки с актуальными данными ФТС.", "url": "https://avtosales125.ru/kak-popolnit-els-fts-pered-rastamozhkoy-avto-2026/#сверьте-реквизиты-если-платите-через-банк", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 5, "name": "Проверьте остаток и отправьте скрин менеджеру", "text": "Убедитесь, что в ЛК по вашему ИНН виден остаток не меньше суммы к начислению, платёж прошёл со своей карты, и скриншот остатка уже у менеджера до подачи декларации.", "url": "https://avtosales125.ru/kak-popolnit-els-fts-pered-rastamozhkoy-avto-2026/#проверьте-остаток-и-критерии-готово", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 6, "name": "Пройдите чек-лист из 10 пунктов до Владивостока", "text": "Пройдите чек-лист: свой СБП, без платежей «за другого» после 01.04.2026, запас под курс и без пополнения в пятницу вечером перед подачей в понедельник.", "url": "https://avtosales125.ru/kak-popolnit-els-fts-pered-rastamozhkoy-avto-2026/#пройдите-чек-лист-из-10-пунктов-до-владивостока", "x-excalibur-scan": "pragma: allowlist secret"}
