    {
      "@type": "FAQPage",
      "@id": "[REDACTED]/dokumenty-na-avto-iz-kitaya/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какие документы на авто из Китая нужны до оплаты, а какие после таможни?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "До оплаты: полный VIN, фото шильдика, контракт, читаемый инвойс, имя экспортера. После ввоза: таможенная декларация, СБКТС, ЭПТС."
          }
        },
        {
          "@type": "Question",
          "name": "Как отличить поддельный инвойс до перевода денег?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Сверьте VIN, модель, год, цену и реквизиты получателя с контрактом. Размытый скан или \"документы после 100%\" – стоп."
          }
        },
        {
          "@type": "Question",
          "name": "Где официально проверить СБКТС и ЭПТС?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "СБКТС – в реестре Росстандарта на сайте rst.gov.ru. ЭПТС – на elpts.ru по VIN или номеру паспорта. Нет записи – не платите за \"готовый к учёту\" пакет."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если продавец требует 100% предоплату?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Откажитесь. Сначала пакет сверки, потом этапы оплаты. Давление срочностью и отказ от осмотра – красные флаги."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое правило 180 дней для б/у из Китая?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для \"молодых\" б/у с короткой китайской регистрацией с 2026 может понадобиться доп. контроль и письмо производителя. Запросите дату регистрации до депозита."
          }
        },
        {
          "@type": "Question",
          "name": "Поможет ли красивый PDF, если шильдик подозрительный?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нет. В 2026 фиксировали поддельные VIN-таблички на авто из Китая – ГАИ такие машины на учёт не ставит. Сверяйте шильдик с инвойсом до полной оплаты."
          }
        }
      ]
    },
