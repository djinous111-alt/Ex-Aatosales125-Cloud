# Excalibur BLOG — credentials (copy to site.env.local)
PUBLIC_SITE_URL=[REDACTED]
WP_SITE_URL=[REDACTED]
WP_HOME=[REDACTED]

YANDEX_METRIKA_COUNTER_ID=[REDACTED]
YANDEX_METRIKA_COUNTER_NAME=Дзен

FTP_HOST=[REDACTED]
FTP_PORT=21
FTP_USER=
FTP_PASS=
# Beget FTP account is often already chrooted to public_html → use /
FTP_ROOT=/

SSH_HOST=[REDACTED]
# Optional: stable IPv4/IPv6 with TCP/22 when Cloud DNS cannot resolve SSH_HOST.
# Do NOT put PUBLIC_SITE_URL HTTP IP here — Beget HTTP and SSH endpoints often differ.
# SSH_HOST_IP=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PATH=[REDACTED]
# SSH_PATH maps to SSH_ROOT when SSH_ROOT empty (login cwd often ".")

EXCALIBUR_BLOG_ALLOW_PUBLISH=no
CATALOG_URL=[REDACTED]
TELEGRAM_URL=[REDACTED]
TELEGRAM_HANDLE=avtosales125
MAX_URL=[REDACTED]
