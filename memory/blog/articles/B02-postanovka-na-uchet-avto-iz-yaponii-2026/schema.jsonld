    {
      "@type": "FAQPage",
      "@id": "[REDACTED]/postanovka-na-uchet-avto-iz-yaponii-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какие документы нужны для регистрации авто из Японии в 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Паспорт, выписка ЭПТС со статусом \"действующий\", СБКТС, ПТД/ТПО, инвойс/ДКП, действующее ОСАГО, квитанции госпошлины. Для авто старше 4 лет – диагностическая карта. Агентский договор инвойс не заменяет."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли поставить на учёт через Госуслуги без визита?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Заявление и оплату – да. Личный осмотр в МРЭО остаётся: приезжаете на авто с оригиналами, проходите площадку и получаете СТС и номера."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли СБКТС до визита в ГИБДД?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да. При единичном ввозе СБКТС нужен до статуса ЭПТС \"действующий\". Без этой цепочки в МРЭО обычно разворачивают. Делайте лабораторию раньше записи."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если в ЭПТС ошибка в мощности или VIN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не едьте \"как есть\". Исправьте данные у организации, выдавшей ЭПТС, сверьте с СБКТС и железом, дождитесь новой выписки – затем подавайте заявление заново."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько дней даётся на постановку на учёт?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По ФЗ-283 – 10 дней с даты выпуска в обращение или приобретения прав на ранее не учтённое ТС. Сначала закройте статус ЭПТС, потом укладывайтесь в срок записью."
          }
        },
        {
          "@type": "Question",
          "name": "Почему отказали, хотя ОСАГО уже оплачено?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Смотрят дату начала действия, не чек оплаты. Активация часто 1–3 дня. Перенесите визит на день, когда полис уже действует, и возьмите подтверждение с собой."
          }
        }
      ]
    },
