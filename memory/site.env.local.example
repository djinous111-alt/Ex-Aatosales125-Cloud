# Excalibur BLOG — credentials (copy to site.env.local)
PUBLIC_SITE_URL=[REDACTED]
WP_SITE_URL=[REDACTED]
WP_HOME=[REDACTED]

YANDEX_METRIKA_COUNTER_ID=[REDACTED]
YANDEX_METRIKA_COUNTER_NAME=Дзен

FTP_HOST=[REDACTED]
FTP_PORT=21
FTP_USER=
FTP_PASS=
# Beget FTP account is often already chrooted to public_html → use /
FTP_ROOT=/

SSH_HOST=[REDACTED]
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
# Prefer SSH_ROOT=. for Beget login cwd. Cloud Secrets may only set SSH_PATH —
# publish/doctor map SSH_PATH → SSH_ROOT when SSH_ROOT is empty.
SSH_PATH=
SSH_ROOT=.

EXCALIBUR_BLOG_ALLOW_PUBLISH=no
CATALOG_URL=[REDACTED]
TELEGRAM_URL=[REDACTED]
TELEGRAM_HANDLE=avtosales125
MAX_URL=[REDACTED]
# Do not quote values. Do not bash-source this file.
# If memory/site.env.local is missing, publish/doctor auto-write it from process env.
