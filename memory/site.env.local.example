# Excalibur BLOG — credentials (copy to site.env.local)
# Format: unquoted KEY=value. Do NOT write KEY="." or KEY="value" —
# publish _read_env_file strips one quote layer, but nested shell quotes break SSH_ROOT.
PUBLIC_SITE_URL=[REDACTED]
WP_SITE_URL=[REDACTED]
WP_HOME=[REDACTED]

YANDEX_METRIKA_COUNTER_ID=[REDACTED]
YANDEX_METRIKA_COUNTER_NAME=Дзен

FTP_HOST=[REDACTED]
FTP_PORT=21
FTP_USER=
FTP_PASS=
# Beget FTP account is often already chrooted to public_html → use /
FTP_ROOT=/

SSH_HOST=[REDACTED]
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=
SSH_PATH=[REDACTED]
# Login cwd for bootstrap upload (preferred for this SSH account)
SSH_ROOT=.

EXCALIBUR_BLOG_ALLOW_PUBLISH=no
CATALOG_URL=[REDACTED]
TELEGRAM_URL=[REDACTED]
MAX_URL=[REDACTED]
