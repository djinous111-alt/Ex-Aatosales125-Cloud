    {
      "@type": "FAQPage",
      "@id": "${PUBLIC_SITE_URL}/encar-na-russkom-kak-chitat/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли официальный Encar на русском?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Полной русской версии encar.com нет. Откройте оригинальную карточку и включите перевод браузера. Сайты с названием \"Encar на русском\" чаще ведут подбор под заказ – читайте лот на первоисточнике."
          }
        },
        {
          "@type": "Question",
          "name": "Что такое Trust Encar и чем он отличается от листа осмотра?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "В российской выдаче Trust Encar часто = коммерческий канал. Лист 성능점검 – схема кузова по лоту. Диагностика 엔카진단 – отдельная проверка площадки. Для глубокого Carhistory до депозита смотрите тему AS09."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли верить пробегу в Encar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Проверьте пробег и в карточке, и в отчёте: он должен только расти. Расхождение, коммерческие метки или закрытый отчёт – повод остановиться до депозита, а не \"верить на слово\"."
          }
        },
        {
          "@type": "Question",
          "name": "Почему \"без ДТП\" не значит идеальный кузов?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По правилам листа \"авария\" связана с силовым каркасом. Навесные панели могли менять при строке 무사고. Поэтому смотрите схему X/W, а не одну зелёную фразу."
          }
        },
        {
          "@type": "Question",
          "name": "Как перевести манвоны в понятную цену?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Умножьте число в 만원 на 10 000 – получите воны. Это цена в Корее. Сумму \"под ключ\" и пошлины не выдумывайте из головы: актуальный расчёт – в каталоге."
          }
        },
        {
          "@type": "Question",
          "name": "Когда лучше отдать проверку подборщику?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если на схеме есть X/W на силовых, нет свежего отчёта или вы не уверены в переводе терминов – остановите депозит и передайте пакет подборщику до оплаты. Так дешевле, чем чинить сюрприз после выкупа."
          }
        }
      ]
    },
