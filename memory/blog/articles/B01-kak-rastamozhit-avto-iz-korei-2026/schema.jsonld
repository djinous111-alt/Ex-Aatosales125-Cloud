      "step": [
        {"@type": "HowToStep", "position": 1, "name": "Разложите растаможку на три платежа", "text": "Выпишите пошлину (ЕТС), утильсбор, сбор за оформление и отдельно склад/лабораторию – не сравнивайте лоты только по цене в вонах.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#разложите-растаможку-на-три-платежа-а-не-на-одну-сумму", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 2, "name": "Сверьте мощность и объём по документам", "text": "Из корейского registration certificate выпишите месяц выпуска, см³, кВт, л.с. и VIN. Пороги: до 160 л.с. и не больше 3 л; на грани без письменного расчёта – депозит отложите.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#сверьте-мощность-и-объем-по-документам-до-любого-депозита", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 3, "name": "Пройдите этапы через Владивосток", "text": "Зафиксируйте личный ввоз через Владивосток и статус списком: порт → СВХ → декларация и платежи → выпуск → СБКТС → ЭПТС → учёт. Выпуск с таможни – не финиш.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#пройдите-этапы-через-владивосток-от-порта-до-учета", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 4, "name": "Заложите реальные сроки", "text": "Море часто 2–5 дней, полный цикл ориентир 45–55 дней; блок таможня + лаборатория + ЭПТС нередко 14–21 день. Не считайте срок только по дням в море.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#заложите-реальные-сроки-море-короткое-документы-длинные", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 5, "name": "Уточните ЭРА-ГЛОНАСС на дату сделки", "text": "На 19.10.2026 обязательный старт оснащения с 01.04.2026 для физлиц при личном ввозе был отложен. Уточните правило на дату сделки у сопровождающего.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#уточните-эра-глонасс-на-дату-сделки-а-не-по-слухам", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 6, "name": "Соберите документы и платите со своего имени", "text": "Соберите договор/инвойс на своё ФИО, корейский сертификат с экспортной отметкой, коносамент, паспорт РФ и платите таможенные платежи со своего счёта.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#соберите-документы-и-платите-со-своего-имени", "x-excalibur-scan": "pragma: allowlist secret"},
        {"@type": "HowToStep", "position": 7, "name": "Закройте чеклист до оплаты", "text": "Депозит не уходит, пока закрыты цель, мощность/объём, этапы, сроки, ЭРА-ГЛОНАСС и пакет на ваше имя. После чеклиста запросите персональный расчёт под ключ.", "url": "https://avtosales125.ru/kak-rastamozhit-avto-iz-korei-2026/#закройте-чеклист-до-оплаты-ваш-первый-результат-на-сегодня", "x-excalibur-scan": "pragma: allowlist secret"},
