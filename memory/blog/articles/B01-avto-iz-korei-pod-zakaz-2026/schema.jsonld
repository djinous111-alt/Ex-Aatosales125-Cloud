      "@type": "FAQPage",
      "@id": "${PUBLIC_SITE_URL}/avto-iz-korei-pod-zakaz-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Сколько этапов от заказа до выдачи?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ориентир: подбор и проверка → договор/оплата → экспорт и море → СВХ и растаможка → СБКТС/ЭПТС → выдача или доставка по РФ. Это 6–8 блоков, а не один \"магический срок\". Спрашивайте статус по блокам."
          }
        },
        {
          "@type": "Question",
          "name": "Чем \"под заказ\" отличается от покупки во Владивостоке?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Под заказ вы выбираете лот в Корее до выкупа и проходите весь контур. Во Владивостоке берёте из уже пригнанного парка – быстрее, но выбор уже сужен. В обоих случаях историю проверяйте до оплаты."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли оформить всё без поездки в порт?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да, при работе с компанией: подбор, проверка, таможня и отправка автовозом/ж/д идут удалённо. Нужны договор, график платежей и осмотр при получении."
          }
        },
        {
          "@type": "Question",
          "name": "Что входит в \"под ключ\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Обычно авто, корейские расходы, фрахт, таможня, утильсбор, брокер и доставка по РФ – состав пишите в договоре. Не складывайте сами по курсу вона́. Запросите разбитый расчёт под лот и город."
          }
        },
        {
          "@type": "Question",
          "name": "Почему важны 2,0 л и 160 л.с.?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Два фильтра: корейский экспортный контроль на объём ДВС и российский льготный утильсбор физлица по мощности. Лот вне фильтров либо сложно вывезти легально, либо резко дорожает. Сначала фильтры, потом комплектация."
          }
        },
        {
          "@type": "Question",
          "name": "Когда машина уже формально \"ваша\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не в момент швартовки. После выпуска с таможни, оплаты сборов, готового СБКТС и ЭПТС со статусом \"Действующий\". До этого – этапы процесса, а не ключи в кармане."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать сегодня, если я новичок?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Заполните чеклист до депозита, отберите 2–3 лота с фильтрами и запросите расчёт в каталоге. Не переводите предоплату по скриншоту цены Encar – сначала VIN, история и договор."
          }
        }
      ]
