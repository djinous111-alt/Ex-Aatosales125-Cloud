      "@type": "FAQPage",
      "@id": "[from env PUBLIC_SITE_URL]postanovka-na-uchet-avto-iz-yaponii-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Какие документы нужны для постановки на учёт авто из Японии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Паспорт, выписка ЭПТС со статусом \"действующий\", СБКТС, таможенные документы (ПТД/ТПО/ДТ), заявление и оплата госпошлины. При доставке – акт приёма-передачи; для представителя – доверенность. Соберите пакет до записи."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли поставить авто на учёт через Госуслуги?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Да: подайте заявление на регистрацию ТС, перенесите данные из ЭПТС, выберите подразделение и время, оплатите пошлину. На осмотр приедете лично с оригиналами и машиной."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли техосмотр для свежего импорта из Японии?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Диагностическая карта чаще нужна для авто старше 4 лет – для ТО и страховки. Это не замена СБКТС. Ориентируйтесь на возраст и требования страховщика, не на слухи из чатов."
          }
        },
        {
          "@type": "Question",
          "name": "Чем этап СБКТС/ЭПТС отличается от регистрации в ГИБДД?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "СБКТС и ЭПТС – сертификация и электронный паспорт после ввоза. Постановка на учёт – выдача СТС и номеров в ГИБДД. Без готового ЭПТС в МРЭО рано."
          }
        },
        {
          "@type": "Question",
          "name": "С какой даты считают 10 дней на постановку?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Со дня приобретения прав / выпуска в обращение по ПП 1764. Если авто везут автовозом – дата в акте приёма-передачи. Не откладывайте запись \"на глаз\"."
          }
        },
        {
          "@type": "Question",
          "name": "Нужен ли ОСАГО, чтобы поставили на учёт в 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для регистрационного действия с 01.03.2025 полис не входит в обязательный пакет. Для выезда на дороги ОСАГО нужен. Не путайте окно ГИБДД и правила езды."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать при отказе из-за VIN или таможенки?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Возьмите письменную причину, исправьте расхождение у брокера или лаборатории и подайте снова. Не платите случайным \"решалам\" у входа."
          }
        }
      ]
    },
