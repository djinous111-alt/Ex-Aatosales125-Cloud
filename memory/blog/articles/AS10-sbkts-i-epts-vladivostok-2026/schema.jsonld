    {
      "@type": "FAQPage",
      "@id": "[REDACTED]/sbkts-i-epts-vladivostok-2026/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Можно ли получить ЭПТС без СБКТС?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Для единичного ввоза б/у – нет: без СБКТС не оформят законный ЭПТС, а без него нет нормального учёта. Сначала осмотр и СБКТС в реестре, потом ЭПТС."
          }
        },
        {
          "@type": "Question",
          "name": "Сколько занимает оформление СБКТС и ЭПТС во Владивостоке?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "СБКТС часто 1–3 рабочих дня при полном пакете, иногда 2–5 или до 5–10 – зависит от загрузки и состояния машины. Плюс ожидание статуса \"действующий\" по утильсбору. Не ориентируйтесь на рекламу \"за 1 день всегда\"."
          }
        },
        {
          "@type": "Question",
          "name": "Чем СБКТС отличается от ОТТС для частника?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ОТТС – для типа/серии (заводы, дилеры). СБКТС – для вашей одной машины с пробегом. Физлицу при ввозе из Азии обычно нужен СБКТС: просите именно его."
          }
        },
        {
          "@type": "Question",
          "name": "Нужна ли ЭРА-ГЛОНАСС физлицу в 2026?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "По отсрочке для физлиц при личном ввозе проверку УВЭОС не проводят до 31.12.2027. Для ЮЛ/ИП правило другое. Перед оплатой кнопки переспросите аккредитованную лабораторию – в 2026 обсуждают досрочную отмену."
          }
        },
        {
          "@type": "Question",
          "name": "Что делать, если ЭПТС \"незавершённый\"?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Не ездите в ГИБДД. Проверьте VIN на portal.elpts.ru и ждите передачу данных об утильсборе (часто около двух недель). Если статус завис дольше разумного – пишите в поддержку СЭП (help.elpts.ru)."
          }
        },
        {
          "@type": "Question",
          "name": "Как не купить фейковый СБКТС у посредника?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Платите только аккредитованной лаборатории после осмотра. Проверьте лабораторию в Росаккредитации и СБКТС в реестре по VIN. \"Сертификат из чата без машины\" – отказ."
          }
        },
        {
          "@type": "Question",
          "name": "Куда идти, если нет времени разбираться у порта?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Передайте сопровождение команде, которая работает с Владивостоком постоянно. В Авто-Сейлс это переписка в Telegram – без форм на странице и без оплаты \"кнопки\" вслепую."
          }
        }
      ]
