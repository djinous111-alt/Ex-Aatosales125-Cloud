    {
      "@type": "FAQPage",
      "@id": "${PUBLIC_SITE_URL}/encar-na-russkom-kak-chitat/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Есть ли официальный Encar на русском?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Полноценного русского encar.com нет. Откройте карточку на encar.com и включите перевод браузера. Сайты из выдачи чаще ведут к посредникам – сначала первоисточник, потом сервис подбора."
          }
        },
        {
          "@type": "Question",
          "name": "Как перевести цену в манвонах?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Умножьте число в 만원 на 10 000 – получите воны. Сохраните скрин шапки. Без перевода в воны не сравнивайте лоты и не обсуждайте предоплату."
          }
        },
        {
          "@type": "Question",
          "name": "Можно ли верить пробегу в Encar?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Одной цифре в шапке не верьте. Сверьте объявление, лист техосмотра и историю; ищите отметки проката и лизинга. Расхождение – отложите лот до осмотра."
          }
        },
        {
          "@type": "Question",
          "name": "Что значит 무사고 и буквы X / W на схеме?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "무사고 обычно про силовой каркас, а не про \"ничего не красили\". X – замена, W – правка/сварка. Метки на силовых зонах – стоп до вопросов специалисту."
          }
        },
        {
          "@type": "Question",
          "name": "Пустая страховая история – можно брать?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Нельзя решать по пустой сводке. ДТП без страховой могут не отображаться. Соберите VIN, схему и страховую до любых денег."
          }
        },
        {
          "@type": "Question",
          "name": "Когда писать в Авто-Сейлс, а не разбирать всё самому?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Если после чеклиста остались флаги, нет VIN/свежих отчётов или продавец давит на предоплату – передайте ссылку и скрины в каталог или Telegram до перевода."
          }
        }
      ]
    },
